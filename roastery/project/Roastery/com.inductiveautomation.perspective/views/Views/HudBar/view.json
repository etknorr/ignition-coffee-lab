{
  "custom": {
    "clockText": "00:00",
    "clockCaption": "ROAST TIME",
    "phaseText": "Pre-charge",
    "themeMode": "System"
  },
  "params": {},
  "propConfig": {
    "custom.clockText": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(({[default]Roastery/CurrentBatch/DropTime} != null && ({[default]Roastery/CurrentBatch/State} = 'Dropped' || {[default]Roastery/CurrentBatch/State} = 'Cooling' || {[default]Roastery/CurrentBatch/State} = 'Complete')), numberFormat(floor((now() - {[default]Roastery/CurrentBatch/DropTime}) / 60000), '00') + ':' + numberFormat(floor(((now() - {[default]Roastery/CurrentBatch/DropTime}) / 1000) % 60), '00'), if({[default]Roastery/CurrentBatch/State} = 'Roasting', numberFormat(floor((now() - {[default]Roastery/CurrentBatch/StartTime}) / 60000), '00') + ':' + numberFormat(floor(((now() - {[default]Roastery/CurrentBatch/StartTime}) / 1000) % 60), '00'), '00:00'))"
        }
      }
    },
    "custom.clockCaption": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(({[default]Roastery/CurrentBatch/DropTime} != null && ({[default]Roastery/CurrentBatch/State} = 'Dropped' || {[default]Roastery/CurrentBatch/State} = 'Cooling' || {[default]Roastery/CurrentBatch/State} = 'Complete')), 'SINCE DROP', 'ROAST TIME')"
        }
      }
    },
    "custom.phaseText": {
      "binding": {
        "type": "tag",
        "config": {
          "tagPath": "[default]Roastery/CurrentBatch/PhaseLabel",
          "mode": "direct",
          "bidirectional": false
        },
        "bidirectional": false
      }
    },
    "custom.themeMode": {
      "binding": {
        "type": "tag",
        "config": {
          "tagPath": "[default]Roastery/AppSettings/ThemeMode",
          "mode": "direct",
          "bidirectional": false
        },
        "bidirectional": false
      },
      "onChange": {
        "enabled": true,
        "script": "\timport roastery.core\n\troastery.core.on_theme_mode_change(self)\n"
      }
    }
  },
  "props": {
    "defaultSize": {
      "width": 900,
      "height": 54
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "HudBarRoot"
    },
    "props": {
      "direction": "row",
      "justify": "flex-start",
      "alignItems": "center",
      "style": {
        "classes": "roast-hud"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "HudState"
        },
        "props": {
          "text": "Idle",
          "style": {
            "classes": "roast-pill"
          }
        },
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "88px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "tag",
              "config": {
                "tagPath": "[default]Roastery/CurrentBatch/State",
                "mode": "direct",
                "bidirectional": false
              },
              "bidirectional": false
            }
          },
          "props.style.backgroundColor": {
            "binding": {
              "type": "tag",
              "config": {
                "tagPath": "[default]Roastery/CurrentBatch/State",
                "mode": "direct",
                "bidirectional": false
              },
              "transforms": [
                {
                  "type": "map",
                  "inputType": "scalar",
                  "outputType": "color",
                  "fallback": "#6b7280",
                  "mappings": [
                    {
                      "input": "Idle",
                      "output": "#6b7280"
                    },
                    {
                      "input": "Roasting",
                      "output": "#dc2626"
                    },
                    {
                      "input": "Dropped",
                      "output": "#475569"
                    },
                    {
                      "input": "Cooling",
                      "output": "#0284c7"
                    },
                    {
                      "input": "Complete",
                      "output": "#16a34a"
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Bean"
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "roast-hud-field"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "BeanCap"
            },
            "props": {
              "text": "BEAN F",
              "style": {
                "classes": "roast-hud-cap"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "BeanVal"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "roast-hud-value"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "tagPath": "[default]Roastery/CurrentBatch/BeanTempF",
                    "mode": "direct",
                    "bidirectional": false
                  },
                  "bidirectional": false,
                  "transforms": [
                    {
                      "type": "format",
                      "formatType": "numeric",
                      "formatValue": "0"
                    }
                  ]
                }
              }
            }
          }
        ],
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "38px"
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Ror"
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "roast-hud-field"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "RorCap"
            },
            "props": {
              "text": "ROR",
              "style": {
                "classes": "roast-hud-cap"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "RorVal"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "roast-hud-value"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "tagPath": "[default]Roastery/CurrentBatch/RateOfRiseDisplayText",
                    "mode": "direct",
                    "bidirectional": false
                  },
                  "bidirectional": false
                }
              }
            }
          }
        ],
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "36px"
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Clock"
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "roast-hud-field"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "ClockCap"
            },
            "props": {
              "text": "ROAST TIME",
              "style": {
                "classes": "roast-hud-cap"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.custom.clockCaption"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "ClockVal"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "roast-hud-value"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.custom.clockText"
                  }
                }
              }
            }
          }
        ],
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "52px"
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Phase"
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "roast-hud-field"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "PhaseCap"
            },
            "props": {
              "text": "PHASE",
              "style": {
                "classes": "roast-hud-cap"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "PhaseVal"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "roast-hud-value-phase"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.custom.phaseText"
                  }
                }
              }
            }
          }
        ],
        "position": {
          "grow": 1,
          "shrink": 0,
          "basis": "auto"
        }
      },
      {
        "type": "ia.input.button",
        "meta": {
          "name": "GearButton"
        },
        "props": {
          "text": "",
          "image": {
            "icon": {
              "path": "material/settings"
            },
            "width": 22,
            "height": 22
          },
          "style": {
            "classes": "roast-btn roast-btn-ghost roast-gear-btn"
          }
        },
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "31px"
        },
        "events": {
          "dom": {
            "onClick": {
              "scope": "G",
              "type": "script",
              "config": {
                "script": "\timport roastery.core\n\troastery.core.toggle_app_settings(self)\n"
              }
            }
          }
        }
      },
      {
        "type": "ia.input.button",
        "meta": {
          "name": "BrightDarkBtn"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "roast-brightness-probe"
          }
        },
        "events": {
          "dom": {
            "onClick": {
              "scope": "G",
              "type": "script",
              "config": {
                "script": "\timport roastery.core\n\troastery.core.set_chart_dark(self, True)\n"
              }
            }
          }
        },
        "position": {
          "basis": "1px",
          "shrink": 0,
          "grow": 0
        }
      },
      {
        "type": "ia.input.button",
        "meta": {
          "name": "BrightLightBtn"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "roast-brightness-probe"
          }
        },
        "events": {
          "dom": {
            "onClick": {
              "scope": "G",
              "type": "script",
              "config": {
                "script": "\timport roastery.core\n\troastery.core.set_chart_dark(self, False)\n"
              }
            }
          }
        },
        "position": {
          "basis": "1px",
          "shrink": 0,
          "grow": 0
        }
      }
    ]
  },
  "events": {
    "system": {
      "onStartup": {
        "scope": "G",
        "type": "script",
        "config": {
          "script": "\timport roastery.core\n\troastery.core.init_chart_dark(self)\n\troastery.core.report_brightness(self)\n"
        }
      }
    }
  }
}