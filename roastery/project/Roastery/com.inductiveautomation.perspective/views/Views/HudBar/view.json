                "classes": "roast-hud-value"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "tagPath": "[default]Roastery/CurrentBatch/BeanTempF",
                    "mode": "direct",
                    "bidirectional": false
                  },
                  "bidirectional": false,
                  "transforms": [
                    {
                      "type": "format",
