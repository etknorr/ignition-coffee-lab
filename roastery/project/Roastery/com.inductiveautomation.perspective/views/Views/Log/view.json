{
  "custom": {
    "selCurve": "",
    "selLabel": "",
    "selNote": "Select a roast to view it as a background."
  },
  "params": {},
  "propConfig": {},
  "props": {
    "defaultSize": {
      "width": 1440,
      "height": 700
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "var(--containerRoot)",
        "minHeight": "100%"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Content"
        },
        "props": {
          "direction": "column",
          "style": {
            "padding": "18px 22px",
            "gap": "14px"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "HeadRow"
            },
            "props": {
              "direction": "row",
              "justify": "space-between",
              "alignItems": "center"
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Title"
                },
                "props": {
                  "text": "Roast Log",
                  "style": {
                    "fontSize": "20px",
                    "fontWeight": "700",
                    "color": "var(--label)"
                  }
                }
              },
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "ConsoleButton"
                },
                "props": {
                  "text": "Back to Console",
                  "style": {
                    "fontSize": "13px",
                    "fontWeight": "700",
                    "color": "#ffffff",
                    "borderRadius": "10px",
                    "padding": "8px 18px",
                    "cursor": "pointer",
                    "border": "none",
                    "backgroundColor": "#0c7bb3"
                  }
                },
                "events": {
                  "dom": {
                    "onClick": {
                      "scope": "G",
                      "type": "script",
                      "config": {
                        "script": "\tsystem.perspective.navigate(page='/')\n"
                      }
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "LogCard"
            },
            "props": {
              "direction": "column",
              "style": {
                "backgroundColor": "var(--container)",
                "border": "1px solid var(--border)",
                "borderRadius": "16px",
                "boxShadow": "var(--boxShadow2)",
                "padding": "16px 18px",
                "gap": "12px"
              }
            },
            "children": [
              {
                "type": "ia.display.table",
                "meta": {
                  "name": "RoastTable"
                },
                "props": {
                  "data": [],
                  "columns": [
                    {
                      "field": "batch",
                      "header": {
                        "title": "Batch"
                      },
                      "width": 70
                    },
                    {
                      "field": "roastDate",
                      "header": {
                        "title": "Date"
                      },
                      "width": 150,
                      "render": "date",
                      "dateFormat": "YYYY-MM-DD h:mm a"
                    },
                    {
                      "field": "bean",
                      "header": {
                        "title": "Bean"
                      },
                      "width": 150
                    },
                    {
                      "field": "origin",
                      "header": {
                        "title": "Origin"
                      },
                      "width": 130
                    },
                    {
                      "field": "chargeG",
                      "header": {
                        "title": "Charge (g)"
                      },
                      "width": 90
                    },
                    {
                      "field": "dropTempF",
                      "header": {
                        "title": "Drop (F)"
                      },
                      "width": 80
                    },
                    {
                      "field": "totalSec",
                      "header": {
                        "title": "Total (s)"
                      },
                      "width": 80
                    },
                    {
                      "field": "drySec",
                      "header": {
                        "title": "Dry (s)"
                      },
                      "width": 70
                    },
                    {
                      "field": "maillardSec",
                      "header": {
                        "title": "Maillard (s)"
                      },
                      "width": 90
                    },
                    {
                      "field": "devSec",
                      "header": {
                        "title": "Dev (s)"
                      },
                      "width": 70
                    },
                    {
                      "field": "dtrPct",
                      "header": {
                        "title": "DTR %"
                      },
                      "width": 70
                    },
                    {
                      "field": "weightLossPct",
                      "header": {
                        "title": "Loss %"
                      },
                      "width": 70
                    },
                    {
                      "field": "auc",
                      "header": {
                        "title": "AUC"
                      },
                      "width": 70
                    },
                    {
                      "field": "level",
                      "header": {
                        "title": "Degree"
                      },
                      "width": 100
                    },
                    {
                      "field": "curveJson",
                      "header": {
                        "title": "Curve"
                      },
                      "width": 60,
                      "visible": false
                    }
                  ],
                  "pager": {
                    "enabled": false
                  },
                  "rows": {
                    "height": 34
                  },
                  "header": {
                    "height": 36,
                    "style": {
                      "backgroundColor": "var(--containerNested)",
                      "color": "var(--label)",
                      "fontWeight": "700",
                      "fontSize": "12px"
                    }
                  },
                  "style": {
                    "fontSize": "13px",
                    "color": "var(--label)",
                    "backgroundColor": "var(--container)"
                  }
                },
                "propConfig": {
                  "props.data": {
                    "binding": {
                      "type": "tag",
                      "config": {
                        "tagPath": "[default]Roastery/RoastLog",
                        "mode": "direct",
                        "bidirectional": false
                      },
                      "bidirectional": false
                    }
                  }
                },
                "events": {
                  "component": {
                    "onRowClick": {
                      "scope": "G",
                      "type": "script",
                      "config": {
                        "script": "\trow = event.value\n\ttry:\n\t\tcurve = row['curveJson']\n\t\tbatch = row['batch']\n\t\tbean = row['bean']\n\texcept:\n\t\tcurve = row.get('curveJson')\n\t\tbatch = row.get('batch')\n\t\tbean = row.get('bean')\n\tself.view.custom.selCurve = curve\n\tself.view.custom.selLabel = 'Batch ' + str(batch) + ' - ' + str(bean)\n\tself.view.custom.selNote = 'Selected batch ' + str(batch) + ' (' + str(bean) + '). Choose View as Background to overlay it on the console.'\n"
                      }
                    }
                  }
                },
                "position": {
                  "grow": 0,
                  "shrink": 0,
                  "basis": "380px"
                }
              },
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "FootRow"
                },
                "props": {
                  "direction": "row",
                  "justify": "space-between",
                  "alignItems": "center",
                  "style": {
                    "gap": "12px"
                  }
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "SelNote"
                    },
                    "props": {
                      "text": "Select a roast to view it as a background.",
                      "style": {
                        "fontSize": "13px",
                        "color": "var(--neutral-70)"
                      }
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "type": "property",
                          "config": {
                            "path": "view.custom.selNote"
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "ia.input.button",
                    "meta": {
                      "name": "BgButton"
                    },
                    "props": {
                      "text": "View as Background",
                      "style": {
                        "fontSize": "13px",
                        "fontWeight": "700",
                        "color": "#ffffff",
                        "borderRadius": "10px",
                        "padding": "9px 20px",
                        "cursor": "pointer",
                        "border": "none",
                        "backgroundColor": "#7c3aed"
                      }
                    },
                    "events": {
                      "dom": {
                        "onClick": {
                          "scope": "G",
                          "type": "script",
                          "config": {
                            "script": "\tcurve = self.view.custom.selCurve\n\tlabel = self.view.custom.selLabel\n\tif curve:\n\t\tsystem.tag.writeBlocking(['[default]Roastery/BackgroundCurveJson', '[default]Roastery/BackgroundLabel'], [curve, label])\n\t\tB = '[default]Roastery/CurrentBatch'\n\t\tstart = system.tag.readBlocking([B + '/StartTime'])[0].value\n\t\tif start is not None:\n\t\t\tfrom java.util import Date\n\t\t\timport json as _json\n\t\t\trows = []\n\t\t\tstartMs = start.getTime()\n\t\t\tfor pair in _json.loads(curve):\n\t\t\t\trows.append([Date(long(startMs + float(pair[0]) * 1000)), float(pair[1])])\n\t\t\tsystem.tag.writeBlocking(['[default]Roastery/BackgroundDS'], [system.dataset.toDataSet(['t_stamp', 'bg'], rows)])\n\tsystem.perspective.navigate(page='/')\n"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}