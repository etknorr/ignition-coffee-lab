{
  "custom": {},
  "params": {},
  "propConfig": {},
  "props": {
    "defaultSize": {
      "width": 800,
      "height": 62
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "TabBarRoot"
    },
    "props": {
      "direction": "row",
      "alignItems": "center",
      "style": {
        "classes": "roast-tabbar"
      }
    },
    "children": [
      {
        "type": "ia.navigation.horizontalmenu",
        "meta": {
          "name": "TabMenu"
        },
        "props": {
          "items": [
            {
              "enabled": true,
              "icon": {
                "path": "material/whatshot"
              },
              "items": [],
              "label": "Roast",
              "style": {
                "classes": ""
              },
              "target": "/"
            },
            {
              "enabled": true,
              "icon": {
                "path": "material/settings"
              },
              "items": [],
              "label": "Settings",
              "style": {
                "classes": ""
              },
              "target": "/settings"
            },
            {
              "enabled": true,
              "icon": {
                "path": "material/history"
              },
              "items": [],
              "label": "Log",
              "style": {
                "classes": ""
              },
              "target": "/log"
            }
          ],
          "enabled": true,
          "itemStyle": {
            "classes": "roast-tab-item"
          },
          "style": {
            "classes": ""
          }
        },
        "position": {
          "grow": 1,
          "basis": "0px"
        },
        "propConfig": {
          "props.items[0].style.fontWeight": {
            "binding": {
              "type": "property",
              "config": {
                "path": "page.props.path"
              },
              "transforms": [
                {
                  "type": "expression",
                  "expression": "if ({value} = {this.props.items[0].target}, \"bold\", \"normal\")"
                }
              ]
            }
          },
          "props.items[0].style.classes": {
            "binding": {
              "type": "property",
              "config": {
                "path": "page.props.path"
              },
              "transforms": [
                {
                  "type": "expression",
                  "expression": "if ({value} = {this.props.items[0].target}, \"roast-tab-active\", \"\")"
                }
              ]
            }
          },
          "props.items[1].style.fontWeight": {
            "binding": {
              "type": "property",
              "config": {
                "path": "page.props.path"
              },
              "transforms": [
                {
                  "type": "expression",
                  "expression": "if ({value} = {this.props.items[1].target}, \"bold\", \"normal\")"
                }
              ]
            }
          },
          "props.items[1].style.classes": {
            "binding": {
              "type": "property",
              "config": {
                "path": "page.props.path"
              },
              "transforms": [
                {
                  "type": "expression",
                  "expression": "if ({value} = {this.props.items[1].target}, \"roast-tab-active\", \"\")"
                }
              ]
            }
          },
          "props.items[2].style.fontWeight": {
            "binding": {
              "type": "property",
              "config": {
                "path": "page.props.path"
              },
              "transforms": [
                {
                  "type": "expression",
                  "expression": "if ({value} = {this.props.items[2].target}, \"bold\", \"normal\")"
                }
              ]
            }
          },
          "props.items[2].style.classes": {
            "binding": {
              "type": "property",
              "config": {
                "path": "page.props.path"
              },
              "transforms": [
                {
                  "type": "expression",
                  "expression": "if ({value} = {this.props.items[2].target}, \"roast-tab-active\", \"\")"
                }
              ]
            }
          }
        }
      }
    ]
  }
}