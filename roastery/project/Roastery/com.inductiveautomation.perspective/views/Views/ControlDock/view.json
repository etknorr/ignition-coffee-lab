                        "binding": {
                          "type": "tag",
                          "config": {
                            "tagPath": "[default]Roastery/CurrentBatch/FanLevel",
                            "mode": "direct",
                            "bidirectional": false
                          },
                          "bidirectional": false,
                          "transforms": [
                            {
                              "type": "format",
                              "formatType": "numeric",
                              "formatValue": "0"
