{
  "custom": {},
  "params": {},
  "propConfig": {},
  "props": {
    "defaultSize": {
      "width": 390,
      "height": 150
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "ControlDockRoot"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "roast-controldock"
      }
    },
    "children": [
      {
        "type": "ia.display.flex-repeater",
        "meta": {
          "name": "DockRepeater"
        },
        "props": {
          "path": "Views/DockButton",
          "instances": [],
          "direction": "row",
          "wrap": "nowrap",
          "justify": "flex-start",
          "alignItems": "stretch",
          "elementPosition": {
            "grow": 1,
            "shrink": 1,
            "basis": "0px"
          },
          "useDefaultViewWidth": false,
          "useDefaultViewHeight": false,
          "style": {
            "classes": "roast-gap-8"
          }
        },
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "48px"
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "type": "tag",
              "config": {
                "tagPath": "[default]Roastery/CurrentBatch/DockActionsJson",
                "mode": "direct",
                "bidirectional": false
              },
              "bidirectional": false,
              "transforms": [
                {
                  "type": "script",
                  "code": "\timport system\n\titems = system.util.jsonDecode(value) or []\n\tout = []\n\tfor d in items:\n\t\tinst = dict(d)\n\t\tif d.get('lead'):\n\t\t\tpos = {'grow': 2, 'shrink': 1, 'basis': '0px'}\n\t\telif d.get('kind') == 'custom':\n\t\t\tpos = {'grow': 1, 'shrink': 1, 'basis': '0px'}\n\t\telse:\n\t\t\tpos = {'grow': 1, 'shrink': 1, 'basis': '0px'}\n\t\tinst['instancePosition'] = pos\n\t\tout.append(inst)\n\treturn out\n"
                }
              ]
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Steppers"
        },
        "props": {
          "direction": "row",
          "style": {
            "classes": "roast-gap-12"
          }
        },
