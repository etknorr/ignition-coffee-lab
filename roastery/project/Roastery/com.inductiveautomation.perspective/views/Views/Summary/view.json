{
  "custom": {
    "saveNote": ""
  },
  "params": {},
  "propConfig": {},
  "props": {
    "defaultSize": {
      "width": 380,
      "height": 430
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "roast-card roast-gap-8"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Heading"
        },
        "props": {
          "text": "Roast Summary",
          "style": {
            "classes": "roast-section-title"
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Total"
        },
        "props": {
          "direction": "row",
          "justify": "space-between",
          "alignItems": "baseline",
          "style": {
            "classes": "roast-gap-10"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "TotalCap"
            },
            "props": {
              "text": "Total time",
              "style": {
                "classes": "roast-caption"
              }
            },
            "position": {
              "grow": 1,
              "shrink": 1,
              "basis": "0px"
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "TotalVal"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "roast-value-right"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({[default]Roastery/CurrentBatch/DropElapsedSec} >= 0, numberFormat(floor({[default]Roastery/CurrentBatch/DropElapsedSec} / 60), '00') + ':' + numberFormat({[default]Roastery/CurrentBatch/DropElapsedSec} % 60, '00'), '--:--')"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Dry"
        },
        "props": {
          "direction": "row",
          "justify": "space-between",
          "alignItems": "baseline",
          "style": {
            "classes": "roast-gap-10"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "DryCap"
            },
            "props": {
              "text": "Drying",
              "style": {
                "classes": "roast-caption"
              }
            },
            "position": {
              "grow": 1,
              "shrink": 1,
              "basis": "0px"
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "DryVal"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "roast-value-right"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({[default]Roastery/CurrentBatch/DryEndElapsedSec} >= 0, numberFormat(floor({[default]Roastery/CurrentBatch/DryEndElapsedSec} / 60), '00') + ':' + numberFormat({[default]Roastery/CurrentBatch/DryEndElapsedSec} % 60, '00'), '--:--')"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Mai"
        },
        "props": {
          "direction": "row",
          "justify": "space-between",
          "alignItems": "baseline",
          "style": {
            "classes": "roast-gap-10"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "MaiCap"
            },
            "props": {
              "text": "Maillard",
              "style": {
                "classes": "roast-caption"
              }
            },
            "position": {
              "grow": 1,
              "shrink": 1,
              "basis": "0px"
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "MaiVal"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "roast-value-right"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec} >= 0 && {[default]Roastery/CurrentBatch/DryEndElapsedSec} >= 0, numberFormat(floor(({[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec} - {[default]Roastery/CurrentBatch/DryEndElapsedSec}) / 60), '00') + ':' + numberFormat(({[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec} - {[default]Roastery/CurrentBatch/DryEndElapsedSec}) % 60, '00'), '--:--')"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Dev"
        },
        "props": {
          "direction": "row",
          "justify": "space-between",
          "alignItems": "baseline",
          "style": {
            "classes": "roast-gap-10"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "DevCap"
            },
            "props": {
              "text": "Development",
              "style": {
                "classes": "roast-caption"
              }
            },
            "position": {
              "grow": 1,
              "shrink": 1,
              "basis": "0px"
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "DevVal"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "roast-value-right"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({[default]Roastery/CurrentBatch/DropElapsedSec} >= 0 && {[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec} >= 0, numberFormat(floor(({[default]Roastery/CurrentBatch/DropElapsedSec} - {[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec}) / 60), '00') + ':' + numberFormat(({[default]Roastery/CurrentBatch/DropElapsedSec} - {[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec}) % 60, '00'), '--:--')"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Dtr"
        },
        "props": {
          "direction": "row",
          "justify": "space-between",
          "alignItems": "baseline",
          "style": {
            "classes": "roast-gap-10"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "DtrCap"
            },
            "props": {
              "text": "Dev ratio (DTR)",
              "style": {
                "classes": "roast-caption"
              }
            },
            "position": {
              "grow": 1,
              "shrink": 1,
              "basis": "0px"
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "DtrVal"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "roast-value-right"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({[default]Roastery/CurrentBatch/DropElapsedSec} > 0 && {[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec} >= 0, numberFormat(({[default]Roastery/CurrentBatch/DropElapsedSec} - {[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec}) * 100.0 / {[default]Roastery/CurrentBatch/DropElapsedSec}, '0.0') + '%', '--')"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "DropT"
        },
        "props": {
          "direction": "row",
          "justify": "space-between",
          "alignItems": "baseline",
          "style": {
            "classes": "roast-gap-10"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "DropTCap"
            },
            "props": {
              "text": "Drop temp",
              "style": {
                "classes": "roast-caption"
              }
            },
            "position": {
              "grow": 1,
              "shrink": 1,
              "basis": "0px"
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "DropTVal"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "roast-value-right"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({[default]Roastery/CurrentBatch/DropElapsedSec} >= 0, numberFormat({[default]Roastery/CurrentBatch/DropTempF}, '0') + ' F', '--')"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Degree"
        },
        "props": {
          "direction": "row",
          "justify": "space-between",
          "alignItems": "baseline",
          "style": {
            "classes": "roast-gap-10"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "DegreeCap"
            },
            "props": {
              "text": "Roast degree",
              "style": {
                "classes": "roast-caption"
              }
            },
            "position": {
              "grow": 1,
              "shrink": 1,
              "basis": "0px"
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "DegreeVal"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "roast-value-right"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({[default]Roastery/CurrentBatch/DropElapsedSec} < 0, '--', if({[default]Roastery/CurrentBatch/DropTempF} < 390, 'Cinnamon', if({[default]Roastery/CurrentBatch/DropTempF} < 396, 'New England', if({[default]Roastery/CurrentBatch/DropTempF} < 401, 'American', if({[default]Roastery/CurrentBatch/DropTempF} < 406, 'City', if({[default]Roastery/CurrentBatch/DropTempF} < 411, 'City+', if({[default]Roastery/CurrentBatch/DropTempF} < 416, 'Full City', if({[default]Roastery/CurrentBatch/DropTempF} < 421, 'Full City+', if({[default]Roastery/CurrentBatch/DropTempF} < 426, 'Vienna', if({[default]Roastery/CurrentBatch/DropTempF} < 436, 'French', 'Italian'))))))))))"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "WOut"
        },
        "props": {
          "direction": "row",
          "justify": "space-between",
          "alignItems": "baseline",
          "style": {
            "classes": "roast-gap-10"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "WOutCap"
            },
            "props": {
              "text": "Weight out",
              "style": {
                "classes": "roast-caption"
              }
            },
            "position": {
              "grow": 1,
              "shrink": 1,
              "basis": "0px"
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "WOutVal"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "roast-value-right"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({[default]Roastery/CurrentBatch/WeightOutG} > 0, numberFormat({[default]Roastery/CurrentBatch/WeightOutG}, '0') + ' g', 'not entered')"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Loss"
        },
        "props": {
          "direction": "row",
          "justify": "space-between",
          "alignItems": "baseline",
          "style": {
            "classes": "roast-gap-10"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "LossCap"
            },
            "props": {
              "text": "Weight loss",
              "style": {
                "classes": "roast-caption"
              }
            },
            "position": {
              "grow": 1,
              "shrink": 1,
              "basis": "0px"
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "LossVal"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "roast-value-right"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({[default]Roastery/CurrentBatch/WeightOutG} > 0 && {[default]Roastery/CurrentBatch/ChargeWeightG} > 0, numberFormat(({[default]Roastery/CurrentBatch/ChargeWeightG} - {[default]Roastery/CurrentBatch/WeightOutG}) * 100.0 / {[default]Roastery/CurrentBatch/ChargeWeightG}, '0.0') + '%', '--')"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "FootRow"
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "roast-gap-8"
          }
        },
        "children": [
          {
            "type": "ia.input.button",
            "meta": {
              "name": "SaveButton"
            },
            "props": {
              "text": "Save Batch",
              "style": {
                "classes": "roast-btn roast-btn-green"
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{[default]Roastery/CurrentBatch/DropElapsedSec} >= 0"
                  }
                }
              }
            },
            "events": {
              "dom": {
                "onClick": {
                  "scope": "G",
                  "type": "script",
                  "config": {
                    "script": "\timport roastery.core, roastery.batches\n\troastery.batches.save_current_batch(self)\n"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "SaveNote"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "roast-note-success"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.custom.saveNote"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  }
}