      {
        "type": "ia.container.flex",
        "meta": {
          "name": "FootRow"
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "6px"
          }
        },
        "children": [
          {
            "type": "ia.input.button",
            "meta": {
              "name": "SaveButton"
            },
            "props": {
              "text": "Save to Roast Log",
              "style": {
                "fontSize": "13px",
                "fontWeight": "700",
                "color": "#ffffff",
                "borderRadius": "10px",
                "padding": "9px 18px",
                "cursor": "pointer",
                "border": "none",
                "backgroundColor": "#15803d"
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{[default]Roastery/CurrentBatch/DropElapsedSec} >= 0"
                  }
                }
              }
            },
            "events": {
              "dom": {
                "onClick": {
                  "scope": "G",
                  "type": "script",
                  "config": {
                    "script": "\tB = '[default]Roastery/CurrentBatch'\n\tnames = ['BatchNumber', 'BeanName', 'Origin', 'ChargeWeightG', 'DropTempF', 'DropElapsedSec', 'DryEndElapsedSec', 'FirstCrackStartElapsedSec', 'WeightOutG', 'StartTime', 'DropTime', 'ChargeTempF']\n\tq = system.tag.readBlocking([B + '/' + n for n in names])\n\td = {}\n\tfor i in range(len(names)):\n\t\td[names[i]] = q[i].value\n\ttotal = d['DropElapsedSec']\n\tdry = d['DryEndElapsedSec']\n\tfc = d['FirstCrackStartElapsedSec']\n\tmai = fc - dry if (fc >= 0 and dry >= 0) else -1\n\tdev = total - fc if (total >= 0 and fc >= 0) else -1\n\tdtr = (dev * 100.0 / total) if (total > 0 and dev >= 0) else 0.0\n\tloss = ((d['ChargeWeightG'] - d['WeightOutG']) * 100.0 / d['ChargeWeightG']) if (d['WeightOutG'] and d['WeightOutG'] > 0 and d['ChargeWeightG'] > 0) else 0.0\n\tdt = d['DropTempF']\n\tlevel = 'Cinnamon' if dt < 390 else 'New England' if dt < 396 else 'American' if dt < 401 else 'City' if dt < 406 else 'City+' if dt < 411 else 'Full City' if dt < 416 else 'Full City+' if dt < 421 else 'Vienna' if dt < 426 else 'French' if dt < 436 else 'Italian'\n\tcurve = []\n\tauc = 0.0\n\tif d['StartTime'] is not None and d['DropTime'] is not None:\n\t\thist = system.tag.queryTagHistory([B + '/BeanTempF'], d['StartTime'], d['DropTime'], returnSize=90, aggregationMode='Average', returnFormat='Wide')\n\t\tprevT = None\n\t\tprevV = None\n\t\tfor r in range(hist.getRowCount()):\n\t\t\tts = hist.getValueAt(r, 0)\n\t\t\tv = hist.getValueAt(r, 1)\n\t\t\tif ts is None or v is None:\n\t\t\t\tcontinue\n\t\t\tsec = (ts.getTime() - d['StartTime'].getTime()) / 1000.0\n\t\t\tcurve.append([round(sec, 1), round(float(v), 1)])\n\t\t\tif prevT is not None:\n\t\t\t\tauc += ((float(v) + prevV) / 2.0 - d['ChargeTempF']) * (sec - prevT) / 60.0\n\t\t\tprevT = sec\n\t\t\tprevV = float(v)\n\timport json\n\trow = [d['BatchNumber'], system.date.now(), d['BeanName'], d['Origin'], float(d['ChargeWeightG']), float(dt), float(total), float(dry), float(mai), float(dev), float(dtr), float(loss), float(auc), level, json.dumps(curve)]\n\tlogPath = '[default]Roastery/RoastLog'\n\tlog = system.tag.readBlocking([logPath])[0].value\n\tif log is None:\n\t\tlog = system.dataset.toDataSet(['batch', 'roastDate', 'bean', 'origin', 'chargeG', 'dropTempF', 'totalSec', 'drySec', 'maillardSec', 'devSec', 'dtrPct', 'weightLossPct', 'auc', 'level', 'curveJson'], [])\n\tlog = system.dataset.addRow(log, row)\n\tsystem.tag.writeBlocking([logPath], [log])\n\tself.view.custom.saveNote = 'Saved batch ' + str(d['BatchNumber']) + ' to the roast log.'\n"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "SaveNote"
            },
            "props": {
              "text": "",
              "style": {
                "fontSize": "12px",
                "color": "#4ade80"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.custom.saveNote"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  }
}