          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "DegreeCap"
            },
            "props": {
              "text": "Roast degree",
              "style": {
                "fontSize": "11px",
                "fontWeight": "700",
                "color": "#8a7360",
                "textTransform": "uppercase",
                "letterSpacing": "0.1em"
              }
            },
