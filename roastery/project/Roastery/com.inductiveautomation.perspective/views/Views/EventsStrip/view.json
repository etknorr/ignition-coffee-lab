            "type": "ia.display.view",
            "meta": {
              "name": "ChargeCell"
            },
            "props": {
              "path": "Views/EventCell",
              "params": {
                "name": "Charge",
                "timeText": "--:--",
                "tempText": "---",
                "done": false
              }
            },
            "position": {
              "grow": 1,
              "shrink": 1,
              "basis": "104px"
            },
            "propConfig": {
              "props.params.timeText": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({[default]Roastery/CurrentBatch/State} != 'Idle', '00:00', '--:--')"
                  }
                }
              },
              "props.params.tempText": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({[default]Roastery/CurrentBatch/State} != 'Idle', numberFormat({[default]Roastery/CurrentBatch/ChargeTempF}, '0') + ' F', '---')"
                  }
                }
              },
              "props.params.done": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{[default]Roastery/CurrentBatch/State} != 'Idle'"
                  }
                }
              }
