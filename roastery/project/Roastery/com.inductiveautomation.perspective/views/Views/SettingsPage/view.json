{
  "custom": {},
  "params": {},
  "propConfig": {},
  "props": {
    "defaultSize": {
      "width": 1100,
      "height": 1400
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "SettingsPageRoot"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "roast-app"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Content"
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "roast-content roast-gap-12"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "HeadRow"
            },
            "props": {
              "direction": "row",
              "alignItems": "flex-start",
              "style": {
                "classes": "roast-gap-12"
              }
            },
            "children": [
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "HeadCol"
                },
                "props": {
                  "direction": "column",
                  "style": {
                    "classes": "roast-gap-8"
                  }
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "Title"
                    },
                    "props": {
                      "text": "Settings",
                      "style": {
                        "classes": "roast-title"
                      }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "Sub"
                    },
                    "props": {
                      "text": "Standing configuration for the roaster. Changes write live tags and apply immediately.",
                      "style": {
                        "classes": "roast-subtitle"
                      }
                    }
                  }
                ],
                "position": {
                  "grow": 1,
                  "shrink": 1,
                  "basis": "0px"
                }
              },
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "GearButton"
                },
                "props": {
                  "text": "",
                  "image": {
                    "icon": {
                      "path": "material/settings"
                    },
                    "width": 22,
                    "height": 22
                  },
                  "style": {
                    "classes": "roast-btn roast-btn-ghost roast-gear-btn"
                  }
                },
                "position": {
                  "grow": 0,
                  "shrink": 0,
                  "basis": "40px"
                },
                "events": {
                  "dom": {
                    "onClick": {
                      "scope": "G",
                      "type": "script",
                      "config": {
                        "script": "\timport roastery.core\n\troastery.core.toggle_app_settings(self)\n"
                      }
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "ia.display.view",
            "meta": {
              "name": "SettingsRoasterEmbed"
            },
            "props": {
              "path": "Views/SettingsRoaster",
              "params": {}
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            }
          },
          {
            "type": "ia.display.view",
