            }
          }
        ]
      }
    ]
  },
  "events": {
    "system": {
      "onStartup": {
        "scope": "G",
        "type": "script",
        "config": {
          "script": "\timport roastery.core\n\troastery.core.page_startup(self)\n"
        }
      }
    }
