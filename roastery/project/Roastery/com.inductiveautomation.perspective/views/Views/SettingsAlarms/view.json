  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "AlarmSection"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "roast-card roast-gap-10"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "AlarmSectionHead"
        },
        "props": {
          "text": "Alarms",
          "style": {
            "classes": "roast-section-title"
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "AlarmSectionDesc"
        },
        "props": {
          "text": "Lite alarms shown as the banner on the Roast page.",
          "style": {
            "classes": "roast-section-desc"
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "AlarmHigh"
        },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "wrap": "wrap",
          "style": {
            "classes": "roast-gap-10"
          }
        },
        "children": [
          {
            "type": "ia.input.checkbox",
            "meta": {
              "name": "AlarmHighCheck"
            },
            "props": {
              "selected": false,
              "text": "",
              "style": {
                "classes": "roast-checkbox"
              }
            },
            "propConfig": {
              "props.selected": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "tagPath": "[default]Roastery/CurrentBatch/AlarmHighTempEnabled",
                    "mode": "direct",
                    "bidirectional": true
                  },
                  "bidirectional": true
                }
              }
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "30px"
            }
          },
          {
            "type": "ia.display.label",
