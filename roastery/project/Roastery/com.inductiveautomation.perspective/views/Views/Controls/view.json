{
  "custom": {},
  "params": {},
  "propConfig": {},
  "props": {
    "defaultSize": {
      "width": 560,
      "height": 470
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "ControlsRoot"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "roast-card roast-gap-10"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "HeadRow"
        },
        "props": {
          "direction": "row",
          "justify": "space-between",
          "alignItems": "center"
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Heading"
            },
            "props": {
              "text": "Roaster Controls",
              "style": {
                "classes": "roast-section-title"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "ModePill"
            },
            "props": {
              "text": "Off",
              "style": {
                "classes": "roast-mode-pill"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "'MODE ' + {[default]Roastery/CurrentBatch/Mode}"
                  }
                }
              },
              "props.style.backgroundColor": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "tagPath": "[default]Roastery/CurrentBatch/Mode",
                    "mode": "direct",
                    "bidirectional": false
                  },
                  "transforms": [
                    {
                      "type": "map",
                      "inputType": "scalar",
                      "outputType": "color",
                      "fallback": "#6b7280",
                      "mappings": [
                        {
                          "input": "Off",
                          "output": "#6b7280"
                        },
                        {
                          "input": "Roast",
                          "output": "#dc2626"
                        },
                        {
                          "input": "Cool",
                          "output": "#0284c7"
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "NewRoastButton"
            },
            "props": {
              "text": "New Roast",
              "style": {
                "classes": "roast-btn roast-btn-sm roast-btn-ghost roast-btn-nowrap"
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{[default]Roastery/CurrentBatch/State} != 'Roasting'"
                  }
                }
              }
            },
            "events": {
              "dom": {
                "onClick": {
                  "scope": "G",
                  "type": "script",
                  "config": {
                    "script": "\timport roastery.core, roastery.batches\n\troastery.batches.new_roast(self)\n"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "PrimaryCap"
        },
        "props": {
          "text": "Roast controls",
          "style": {
            "classes": "roast-caption"
          }
        }
      },
      {
        "type": "ia.display.flex-repeater",
        "meta": {
          "name": "DockRepeater"
        },
        "props": {
          "path": "Views/DockButton",
          "instances": [],
          "direction": "row",
          "wrap": "wrap",
          "justify": "flex-start",
          "alignItems": "stretch",
          "elementPosition": {
            "grow": 1,
            "shrink": 1,
            "basis": "0px"
          },
          "useDefaultViewWidth": false,
          "useDefaultViewHeight": false,
          "style": {
            "classes": "roast-gap-8"
          }
        },
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "auto"
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "type": "tag",
              "config": {
                "tagPath": "[default]Roastery/CurrentBatch/DockActionsJson",
                "mode": "direct",
                "bidirectional": false
              },
              "bidirectional": false,
              "transforms": [
                {
                  "type": "script",
                  "code": "\timport system\n\titems = system.util.jsonDecode(value) or []\n\tout = []\n\tfor d in items:\n\t\tinst = dict(d)\n\t\tif d.get('lead'):\n\t\t\tpos = {'grow': 2, 'shrink': 0, 'basis': '108px'}\n\t\telif d.get('kind') == 'utility':\n\t\t\tpos = {'grow': 1, 'shrink': 0, 'basis': '148px'}\n\t\telse:\n\t\t\tpos = {'grow': 1, 'shrink': 0, 'basis': '88px'}\n\t\tinst['instancePosition'] = pos\n\t\tout.append(inst)\n\treturn out\n"
                }
              ]
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Steppers"
        },
        "props": {
          "direction": "row",
          "wrap": "wrap",
          "style": {
            "classes": "roast-gap-12"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "FanStepper"
            },
            "props": {
              "direction": "column",
              "alignItems": "center",
              "style": {
                "classes": "roast-gap-8"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "FanStepperCaption"
                },
                "props": {
                  "text": "FAN",
                  "style": {
                    "classes": "roast-caption"
                  }
                }
              },
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "FanStepperRow"
                },
                "props": {
                  "direction": "row",
                  "justify": "center",
                  "alignItems": "center",
                  "style": {
                    "classes": "roast-gap-8"
                  }
                },
                "children": [
                  {
                    "type": "ia.input.button",
                    "meta": {
                      "name": "FanStepperMinus"
                    },
                    "props": {
                      "text": "-",
                      "style": {
                        "classes": "roast-btn roast-btn-step-lg roast-btn-reset"
                      }
                    },
                    "events": {
                      "dom": {
                        "onClick": {
                          "scope": "G",
                          "type": "script",
                          "config": {
                            "script": "\timport roastery.core, roastery.batches\n\troastery.core.stepper('FanLevel', -1, 'Fan')\n"
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "FanStepperValue"
                    },
                    "props": {
                      "text": "5",
                      "style": {
                        "classes": "roast-stepper-value"
                      }
                    },
                    "position": {
                      "grow": 0,
                      "shrink": 0,
                      "basis": "44px"
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "type": "tag",
                          "config": {
                            "tagPath": "[default]Roastery/CurrentBatch/FanLevel",
                            "mode": "direct",
                            "bidirectional": false
                          },
                          "bidirectional": false,
                          "transforms": [
                            {
                              "type": "format",
                              "formatType": "numeric",
                              "formatValue": "0"
                            }
                          ]
                        }
                      }
                    }
                  },
                  {
                    "type": "ia.input.button",
                    "meta": {
                      "name": "FanStepperPlus"
                    },
                    "props": {
                      "text": "+",
                      "style": {
                        "classes": "roast-btn roast-btn-step-lg roast-btn-blue"
                      }
                    },
                    "events": {
                      "dom": {
                        "onClick": {
                          "scope": "G",
                          "type": "script",
                          "config": {
                            "script": "\timport roastery.core, roastery.batches\n\troastery.core.stepper('FanLevel', 1, 'Fan')\n"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ],
            "position": {
              "grow": 1,
              "shrink": 1,
              "basis": "150px"
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "HeatStepper"
            },
            "props": {
              "direction": "column",
              "alignItems": "center",
              "style": {
                "classes": "roast-gap-8"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "HeatStepperCaption"
                },
                "props": {
                  "text": "HEAT",
                  "style": {
                    "classes": "roast-caption"
                  }
                }
              },
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "HeatStepperRow"
                },
                "props": {
                  "direction": "row",
                  "justify": "center",
                  "alignItems": "center",
                  "style": {
                    "classes": "roast-gap-8"
                  }
                },
                "children": [
                  {
                    "type": "ia.input.button",
                    "meta": {
                      "name": "HeatStepperMinus"
                    },
                    "props": {
                      "text": "-",
                      "style": {
                        "classes": "roast-btn roast-btn-step-lg roast-btn-reset"
                      }
                    },
                    "events": {
                      "dom": {
                        "onClick": {
                          "scope": "G",
                          "type": "script",
                          "config": {
                            "script": "\timport roastery.core, roastery.batches\n\troastery.core.stepper('HeatLevel', -1, 'Heat')\n"
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "HeatStepperValue"
                    },
                    "props": {
                      "text": "5",
                      "style": {
                        "classes": "roast-stepper-value"
                      }
                    },
                    "position": {
                      "grow": 0,
                      "shrink": 0,
                      "basis": "44px"
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "type": "tag",
                          "config": {
                            "tagPath": "[default]Roastery/CurrentBatch/HeatLevel",
                            "mode": "direct",
                            "bidirectional": false
                          },
                          "bidirectional": false,
                          "transforms": [
                            {
                              "type": "format",
                              "formatType": "numeric",
                              "formatValue": "0"
                            }
                          ]
                        }
                      }
                    }
                  },
                  {
                    "type": "ia.input.button",
                    "meta": {
                      "name": "HeatStepperPlus"
                    },
                    "props": {
                      "text": "+",
                      "style": {
                        "classes": "roast-btn roast-btn-step-lg roast-btn-charge"
                      }
                    },
                    "events": {
                      "dom": {
                        "onClick": {
                          "scope": "G",
                          "type": "script",
                          "config": {
                            "script": "\timport roastery.core, roastery.batches\n\troastery.core.stepper('HeatLevel', 1, 'Heat')\n"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ],
            "position": {
              "grow": 1,
              "shrink": 1,
              "basis": "150px"
            }
          }
        ]
      }
    ]
  },
  "events": {
    "system": {
      "onStartup": {
        "scope": "G",
        "type": "script",
        "config": {
          "script": "\timport roastery.core\n\troastery.core.update_dock_actions()\n"
        }
      }
    }
  }
}
