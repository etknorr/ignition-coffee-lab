                "classes": "roast-section-title"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "ModePill"
            },
            "props": {
              "text": "Off",
              "style": {
                "classes": "roast-mode-pill"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "'MODE ' + {[default]Roastery/CurrentBatch/Mode}"
                  }
                }
              },
              "props.style.backgroundColor": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "tagPath": "[default]Roastery/CurrentBatch/Mode",
                    "mode": "direct",
                    "bidirectional": false
                  },
                  "transforms": [
                    {
                      "type": "map",
                      "inputType": "scalar",
                      "outputType": "color",
                      "fallback": "#6b7280",
                      "mappings": [
                        {
                          "input": "Off",
                          "output": "#6b7280"
                        },
                        {
                          "input": "Roast",
                          "output": "#dc2626"
                        },
                        {
                          "input": "Cool",
                          "output": "#0284c7"
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        ]
