{
  "custom": {},
  "params": {
    "name": "Event",
    "timeText": "--:--",
    "tempText": "---",
    "done": false
  },
  "propConfig": {
    "params.name": {
      "paramDirection": "input"
    },
    "params.timeText": {
      "paramDirection": "input"
    },
    "params.tempText": {
      "paramDirection": "input"
    },
    "params.done": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "width": 120,
      "height": 84
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "alignItems": "center",
      "style": {
        "backgroundColor": "var(--containerNested)",
        "border": "1px solid var(--border)",
        "borderRadius": "12px",
        "padding": "9px 6px",
        "gap": "2px"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "NameLabel"
        },
        "props": {
          "text": "Event",
          "style": {
            "fontSize": "11px",
            "fontWeight": "700",
            "color": "var(--neutral-60)",
            "textTransform": "uppercase",
            "letterSpacing": "0.08em",
            "textAlign": "center"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.name"
              }
            }
          },
          "props.style.color": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.done}, 'var(--callToAction)', 'var(--neutral-60)')"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "TimeLabel"
        },
        "props": {
          "text": "--:--",
          "style": {
            "fontSize": "17px",
            "fontWeight": "700",
            "color": "var(--label)",
            "textAlign": "center"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.timeText"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "TempLabel"
        },
        "props": {
          "text": "---",
          "style": {
            "fontSize": "12px",
            "fontWeight": "600",
            "color": "var(--neutral-70)",
            "textAlign": "center"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.tempText"
              }
            }
          }
        }
      }
    ]
  }
}