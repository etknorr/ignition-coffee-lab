{
  "custom": {},
  "params": {
    "name": "Event",
    "timeText": "--:--",
    "tempText": "---",
    "done": false
  },
  "propConfig": {
    "params.name": {
      "paramDirection": "input"
    },
    "params.timeText": {
      "paramDirection": "input"
    },
    "params.tempText": {
      "paramDirection": "input"
    },
    "params.done": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "width": 120,
      "height": 84
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "alignItems": "center",
      "style": {
        "classes": "roast-cell"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "NameLabel"
        },
        "props": {
          "text": "Event",
          "style": {
            "classes": "roast-event-name"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.name"
              }
            }
          },
          "props.style.color": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.done}, 'var(--callToAction)', 'var(--neutral-60)')"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "TimeLabel"
        },
        "props": {
          "text": "--:--",
          "style": {
            "classes": "roast-event-time"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.timeText"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "TempLabel"
        },
        "props": {
          "text": "---",
          "style": {
            "classes": "roast-event-temp"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.tempText"
              }
            }
          }
        }
      }
    ]
  }
}