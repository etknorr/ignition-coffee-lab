{
  "custom": {},
  "params": {},
  "propConfig": {},
  "props": {
    "defaultSize": {
      "width": 1440,
      "height": 700
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "roast-app"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Content"
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "roast-content"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "HeadRow"
            },
            "props": {
              "direction": "row",
              "justify": "space-between",
              "alignItems": "center"
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Title"
                },
                "props": {
                  "text": "Roast Batches",
                  "style": {
                    "classes": "roast-title"
                  }
                }
              },
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "NewButton"
                },
                "props": {
                  "text": "New Batch",
                  "style": {
                    "classes": "roast-btn roast-btn-sm roast-btn-primary"
                  }
                },
                "events": {
                  "dom": {
                    "onClick": {
                      "scope": "G",
                      "type": "script",
                      "config": {
                        "script": "\timport roastery.core, roastery.batches\n\troastery.batches.open_editor(self, create=True)\n"
                      }
                    }
                  }
                }
              },
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "ConsoleButton"
                },
                "props": {
                  "text": "Back to Console",
                  "style": {
                    "classes": "roast-btn roast-btn-sm roast-btn-ghost"
                  }
                },
                "events": {
                  "dom": {
                    "onClick": {
                      "scope": "G",
                      "type": "script",
                      "config": {
                        "script": "\tsystem.perspective.navigate(page='/')\n"
                      }
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "ia.display.view",
            "meta": {
              "name": "BatchesPanelEmbed"
            },
            "props": {
              "path": "Views/BatchesPanel",
              "params": {}
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            }
          }
        ]
      }
    ]
  }
}