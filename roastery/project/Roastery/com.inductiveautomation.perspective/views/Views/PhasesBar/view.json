{
  "custom": {},
  "params": {},
  "propConfig": {},
  "props": {
    "defaultSize": {
      "width": 1200,
      "height": 108
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "roast-card roast-gap-10"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "HeadRow"
        },
        "props": {
          "direction": "row",
          "justify": "space-between",
          "alignItems": "center"
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Heading"
            },
            "props": {
              "text": "Phases",
              "style": {
                "classes": "roast-section-title"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "DtrLabel"
            },
            "props": {
              "text": "DTR",
              "style": {
                "classes": "roast-accent-text"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({[default]Roastery/CurrentBatch/DropElapsedSec} >= 0, 'DTR ' + numberFormat(({[default]Roastery/CurrentBatch/DropElapsedSec} - {[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec}) * 100.0 / {[default]Roastery/CurrentBatch/DropElapsedSec}, '0.0') + '%', 'DTR target ' + numberFormat({[default]Roastery/CurrentBatch/DTRTargetPct}, '0.0') + '%')"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Bar"
        },
        "props": {
          "direction": "row",
          "style": {
            "classes": "roast-full"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "DrySeg"
            },
            "props": {
              "direction": "row",
              "justify": "center",
              "alignItems": "center",
              "style": {
                "classes": "roast-seg roast-seg-drying"
              }
            },
            "children": [
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "DrySegStack"
                },
                "props": {
                  "direction": "column",
                  "justify": "center",
                  "alignItems": "center"
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "DrySegText"
                    },
                    "props": {
                      "text": "DRYING",
                      "style": {
                        "classes": "roast-seg-text"
                      }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "DrySegDetail"
                    },
                    "props": {
                      "text": "",
                      "style": {
                        "classes": "roast-seg-detail"
                      }
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "if({[default]Roastery/CurrentBatch/DryEndElapsedSec} >= 0, numberFormat(floor({[default]Roastery/CurrentBatch/DryEndElapsedSec} / 60), '00') + ':' + numberFormat({[default]Roastery/CurrentBatch/DryEndElapsedSec} % 60, '00') + ' \u00b7 ' + numberFormat(if({[default]Roastery/CurrentBatch/DropElapsedSec} > 0, {[default]Roastery/CurrentBatch/DryEndElapsedSec} * 100.0 / {[default]Roastery/CurrentBatch/DropElapsedSec}, {[default]Roastery/CurrentBatch/PhaseDryTargetSec} * 100.0 / if(({[default]Roastery/CurrentBatch/PhaseDryTargetSec} + {[default]Roastery/CurrentBatch/PhaseMaillardTargetSec} + {[default]Roastery/CurrentBatch/PhaseDevTargetSec}) > 0, ({[default]Roastery/CurrentBatch/PhaseDryTargetSec} + {[default]Roastery/CurrentBatch/PhaseMaillardTargetSec} + {[default]Roastery/CurrentBatch/PhaseDevTargetSec}), 1)), '0') + '%', 'target ' + numberFormat(floor({[default]Roastery/CurrentBatch/PhaseDryTargetSec} / 60), '00') + ':' + numberFormat({[default]Roastery/CurrentBatch/PhaseDryTargetSec} % 60, '00'))"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ],
            "propConfig": {
              "props.style.width": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "numberFormat({[default]Roastery/CurrentBatch/PhaseDryTargetSec} * 100.0 / if(({[default]Roastery/CurrentBatch/PhaseDryTargetSec} + {[default]Roastery/CurrentBatch/PhaseMaillardTargetSec} + {[default]Roastery/CurrentBatch/PhaseDevTargetSec}) > 0, ({[default]Roastery/CurrentBatch/PhaseDryTargetSec} + {[default]Roastery/CurrentBatch/PhaseMaillardTargetSec} + {[default]Roastery/CurrentBatch/PhaseDevTargetSec}), 1), '0.0') + '%'"
                  }
                }
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "MaiSeg"
            },
            "props": {
              "direction": "row",
              "justify": "center",
              "alignItems": "center",
              "style": {
                "classes": "roast-seg roast-seg-maillard"
              }
            },
            "children": [
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "MaiSegStack"
                },
                "props": {
                  "direction": "column",
                  "justify": "center",
                  "alignItems": "center"
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "MaiSegText"
                    },
                    "props": {
                      "text": "MAILLARD",
                      "style": {
                        "classes": "roast-seg-text"
                      }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "MaiSegDetail"
                    },
                    "props": {
                      "text": "",
                      "style": {
                        "classes": "roast-seg-detail"
                      }
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "if({[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec} >= 0, numberFormat(floor(({[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec} - {[default]Roastery/CurrentBatch/DryEndElapsedSec}) / 60), '00') + ':' + numberFormat(({[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec} - {[default]Roastery/CurrentBatch/DryEndElapsedSec}) % 60, '00') + ' \u00b7 ' + numberFormat(if({[default]Roastery/CurrentBatch/DropElapsedSec} > 0, ({[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec} - {[default]Roastery/CurrentBatch/DryEndElapsedSec}) * 100.0 / {[default]Roastery/CurrentBatch/DropElapsedSec}, {[default]Roastery/CurrentBatch/PhaseMaillardTargetSec} * 100.0 / if(({[default]Roastery/CurrentBatch/PhaseDryTargetSec} + {[default]Roastery/CurrentBatch/PhaseMaillardTargetSec} + {[default]Roastery/CurrentBatch/PhaseDevTargetSec}) > 0, ({[default]Roastery/CurrentBatch/PhaseDryTargetSec} + {[default]Roastery/CurrentBatch/PhaseMaillardTargetSec} + {[default]Roastery/CurrentBatch/PhaseDevTargetSec}), 1)), '0') + '%', 'target ' + numberFormat(floor({[default]Roastery/CurrentBatch/PhaseMaillardTargetSec} / 60), '00') + ':' + numberFormat({[default]Roastery/CurrentBatch/PhaseMaillardTargetSec} % 60, '00'))"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ],
            "propConfig": {
              "props.style.width": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "numberFormat({[default]Roastery/CurrentBatch/PhaseMaillardTargetSec} * 100.0 / if(({[default]Roastery/CurrentBatch/PhaseDryTargetSec} + {[default]Roastery/CurrentBatch/PhaseMaillardTargetSec} + {[default]Roastery/CurrentBatch/PhaseDevTargetSec}) > 0, ({[default]Roastery/CurrentBatch/PhaseDryTargetSec} + {[default]Roastery/CurrentBatch/PhaseMaillardTargetSec} + {[default]Roastery/CurrentBatch/PhaseDevTargetSec}), 1), '0.0') + '%'"
                  }
                }
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "DevSeg"
            },
            "props": {
              "direction": "row",
              "justify": "center",
              "alignItems": "center",
              "style": {
                "classes": "roast-seg roast-seg-development"
              }
            },
            "children": [
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "DevSegStack"
                },
                "props": {
                  "direction": "column",
                  "justify": "center",
                  "alignItems": "center"
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "DevSegText"
                    },
                    "props": {
                      "text": "DEV",
                      "style": {
                        "classes": "roast-seg-text"
                      }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "DevSegDetail"
                    },
                    "props": {
                      "text": "",
                      "style": {
                        "classes": "roast-seg-detail"
                      }
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "if({[default]Roastery/CurrentBatch/DropElapsedSec} >= 0, numberFormat(floor(({[default]Roastery/CurrentBatch/DropElapsedSec} - {[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec}) / 60), '00') + ':' + numberFormat(({[default]Roastery/CurrentBatch/DropElapsedSec} - {[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec}) % 60, '00') + ' \u00b7 ' + numberFormat(if({[default]Roastery/CurrentBatch/DropElapsedSec} > 0, ({[default]Roastery/CurrentBatch/DropElapsedSec} - {[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec}) * 100.0 / {[default]Roastery/CurrentBatch/DropElapsedSec}, {[default]Roastery/CurrentBatch/PhaseDevTargetSec} * 100.0 / if(({[default]Roastery/CurrentBatch/PhaseDryTargetSec} + {[default]Roastery/CurrentBatch/PhaseMaillardTargetSec} + {[default]Roastery/CurrentBatch/PhaseDevTargetSec}) > 0, ({[default]Roastery/CurrentBatch/PhaseDryTargetSec} + {[default]Roastery/CurrentBatch/PhaseMaillardTargetSec} + {[default]Roastery/CurrentBatch/PhaseDevTargetSec}), 1)), '0') + '%', 'target ' + numberFormat(floor({[default]Roastery/CurrentBatch/PhaseDevTargetSec} / 60), '00') + ':' + numberFormat({[default]Roastery/CurrentBatch/PhaseDevTargetSec} % 60, '00'))"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ],
            "propConfig": {
              "props.style.width": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "numberFormat({[default]Roastery/CurrentBatch/PhaseDevTargetSec} * 100.0 / if(({[default]Roastery/CurrentBatch/PhaseDryTargetSec} + {[default]Roastery/CurrentBatch/PhaseMaillardTargetSec} + {[default]Roastery/CurrentBatch/PhaseDevTargetSec}) > 0, ({[default]Roastery/CurrentBatch/PhaseDryTargetSec} + {[default]Roastery/CurrentBatch/PhaseMaillardTargetSec} + {[default]Roastery/CurrentBatch/PhaseDevTargetSec}), 1), '0.0') + '%'"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  }
}