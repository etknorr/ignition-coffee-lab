{
  "custom": {},
  "params": {},
  "propConfig": {},
  "props": {
    "defaultSize": {
      "width": 1200,
      "height": 108
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "roast-card roast-gap-10"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "HeadRow"
        },
        "props": {
          "direction": "row",
          "justify": "space-between",
          "alignItems": "center"
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Heading"
            },
            "props": {
              "text": "Phases",
              "style": {
                "classes": "roast-section-title"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "DtrLabel"
            },
            "props": {
              "text": "DTR",
              "style": {
                "classes": "roast-accent-text"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({[default]Roastery/CurrentBatch/DropElapsedSec} >= 0, 'DTR ' + numberFormat(({[default]Roastery/CurrentBatch/DropElapsedSec} - {[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec}) * 100.0 / {[default]Roastery/CurrentBatch/DropElapsedSec}, '0.0') + '%', 'DTR target ' + numberFormat(({[default]Roastery/CurrentBatch/TargetDropSec} - {[default]Roastery/CurrentBatch/TargetFCSec}) * 100.0 / {[default]Roastery/CurrentBatch/TargetDropSec}, '0.0') + '%')"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Bar"
        },
        "props": {
          "direction": "row",
          "style": {
            "classes": "roast-gap-8 roast-full"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "DrySeg"
            },
            "props": {
              "direction": "row",
              "justify": "center",
              "alignItems": "center",
              "style": {
                "classes": "roast-seg roast-seg-drying"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "DrySegText"
                },
                "props": {
                  "text": "DRYING",
                  "style": {
                    "classes": "roast-seg-text"
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "'DRYING  ' + if({[default]Roastery/CurrentBatch/DryEndElapsedSec} >= 0, numberFormat(floor({[default]Roastery/CurrentBatch/DryEndElapsedSec} / 60), '00') + ':' + numberFormat({[default]Roastery/CurrentBatch/DryEndElapsedSec} % 60, '00') + ' \u00b7 ' + numberFormat(if({[default]Roastery/CurrentBatch/DropElapsedSec} >= 0, {[default]Roastery/CurrentBatch/DryEndElapsedSec} * 100.0 / {[default]Roastery/CurrentBatch/DropElapsedSec}, {[default]Roastery/CurrentBatch/TargetDryEndSec} * 100.0 / {[default]Roastery/CurrentBatch/TargetDropSec}), '0') + '%', 'target ' + numberFormat(floor({[default]Roastery/CurrentBatch/TargetDryEndSec} / 60), '00') + ':' + numberFormat({[default]Roastery/CurrentBatch/TargetDryEndSec} % 60, '00'))"
                      }
                    }
                  }
                }
              }
            ],
            "propConfig": {
              "props.style.width": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "numberFormat(if({[default]Roastery/CurrentBatch/DropElapsedSec} >= 0, {[default]Roastery/CurrentBatch/DryEndElapsedSec} * 100.0 / {[default]Roastery/CurrentBatch/DropElapsedSec}, {[default]Roastery/CurrentBatch/TargetDryEndSec} * 100.0 / {[default]Roastery/CurrentBatch/TargetDropSec}), '0.0') + '%'"
                  }
                }
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "MaiSeg"
            },
            "props": {
              "direction": "row",
              "justify": "center",
              "alignItems": "center",
              "style": {
                "classes": "roast-seg roast-seg-maillard"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "MaiSegText"
                },
                "props": {
                  "text": "MAILLARD",
                  "style": {
                    "classes": "roast-seg-text"
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "'MAILLARD  ' + if({[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec} >= 0, numberFormat(floor(({[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec} - {[default]Roastery/CurrentBatch/DryEndElapsedSec}) / 60), '00') + ':' + numberFormat(({[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec} - {[default]Roastery/CurrentBatch/DryEndElapsedSec}) % 60, '00') + ' \u00b7 ' + numberFormat(if({[default]Roastery/CurrentBatch/DropElapsedSec} >= 0, ({[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec} - {[default]Roastery/CurrentBatch/DryEndElapsedSec}) * 100.0 / {[default]Roastery/CurrentBatch/DropElapsedSec}, ({[default]Roastery/CurrentBatch/TargetFCSec} - {[default]Roastery/CurrentBatch/TargetDryEndSec}) * 100.0 / {[default]Roastery/CurrentBatch/TargetDropSec}), '0') + '%', 'target ' + numberFormat(floor(({[default]Roastery/CurrentBatch/TargetFCSec} - {[default]Roastery/CurrentBatch/TargetDryEndSec}) / 60), '00') + ':' + numberFormat(({[default]Roastery/CurrentBatch/TargetFCSec} - {[default]Roastery/CurrentBatch/TargetDryEndSec}) % 60, '00'))"
                      }
                    }
                  }
                }
              }
            ],
            "propConfig": {
              "props.style.width": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "numberFormat(if({[default]Roastery/CurrentBatch/DropElapsedSec} >= 0, ({[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec} - {[default]Roastery/CurrentBatch/DryEndElapsedSec}) * 100.0 / {[default]Roastery/CurrentBatch/DropElapsedSec}, ({[default]Roastery/CurrentBatch/TargetFCSec} - {[default]Roastery/CurrentBatch/TargetDryEndSec}) * 100.0 / {[default]Roastery/CurrentBatch/TargetDropSec}), '0.0') + '%'"
                  }
                }
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "DevSeg"
            },
            "props": {
              "direction": "row",
              "justify": "center",
              "alignItems": "center",
              "style": {
                "classes": "roast-seg roast-seg-development"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "DevSegText"
                },
                "props": {
                  "text": "DEVELOPMENT",
                  "style": {
                    "classes": "roast-seg-text"
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "'DEVELOPMENT  ' + if({[default]Roastery/CurrentBatch/DropElapsedSec} >= 0, numberFormat(floor(({[default]Roastery/CurrentBatch/DropElapsedSec} - {[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec}) / 60), '00') + ':' + numberFormat(({[default]Roastery/CurrentBatch/DropElapsedSec} - {[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec}) % 60, '00') + ' \u00b7 ' + numberFormat(if({[default]Roastery/CurrentBatch/DropElapsedSec} >= 0, ({[default]Roastery/CurrentBatch/DropElapsedSec} - {[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec}) * 100.0 / {[default]Roastery/CurrentBatch/DropElapsedSec}, ({[default]Roastery/CurrentBatch/TargetDropSec} - {[default]Roastery/CurrentBatch/TargetFCSec}) * 100.0 / {[default]Roastery/CurrentBatch/TargetDropSec}), '0') + '%', 'target ' + numberFormat(floor(({[default]Roastery/CurrentBatch/TargetDropSec} - {[default]Roastery/CurrentBatch/TargetFCSec}) / 60), '00') + ':' + numberFormat(({[default]Roastery/CurrentBatch/TargetDropSec} - {[default]Roastery/CurrentBatch/TargetFCSec}) % 60, '00'))"
                      }
                    }
                  }
                }
              }
            ],
            "propConfig": {
              "props.style.width": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "numberFormat(if({[default]Roastery/CurrentBatch/DropElapsedSec} >= 0, ({[default]Roastery/CurrentBatch/DropElapsedSec} - {[default]Roastery/CurrentBatch/FirstCrackStartElapsedSec}) * 100.0 / {[default]Roastery/CurrentBatch/DropElapsedSec}, ({[default]Roastery/CurrentBatch/TargetDropSec} - {[default]Roastery/CurrentBatch/TargetFCSec}) * 100.0 / {[default]Roastery/CurrentBatch/TargetDropSec}), '0.0') + '%'"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  }
}