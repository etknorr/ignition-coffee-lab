          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "RorSectionDesc"
        },
        "props": {
          "text": "Artisan parameters, applied live by the one library implementation (roastery.core.compute_ror_series) and re-applied to saved batches when they are loaded as a detail or a ghost. Defaults are Artisan 5.0.0 defaults: span 20 s, curve filter 1, delta filter 3, smooth spikes on, clip -18 to 81 F/min.",
