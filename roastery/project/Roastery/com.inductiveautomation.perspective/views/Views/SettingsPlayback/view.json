                    "props": {
                      "text": "Sound is visual only in this build: the Perspective client has no clean beep API reachable from its scripting layer, so the banner prompt is the signal and this switch is stored for when a sound route exists.",
                      "style": {
                        "classes": "roast-note"
                      }
                    },
                    "position": {
                      "grow": 1,
                      "shrink": 1,
                      "basis": "0px"
                    }
