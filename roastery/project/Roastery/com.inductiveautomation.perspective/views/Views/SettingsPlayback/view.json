    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "PlaybackSection"
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "roast-card roast-gap-10"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "PlaybackSectionHead"
            },
            "props": {
              "text": "Background Playback",
              "style": {
                "classes": "roast-section-title"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "PlaybackSectionDesc"
            },
            "props": {
              "text": "When a background ghost is loaded, its Fan and Heat changes and its Drop prompt on the Roast page at their elapsed times, Artisan playback style, each exactly once. Prompts only: nothing is applied automatically, Fan and Heat stay manual.",
              "style": {
                "classes": "roast-section-desc"
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "PbRow1"
