            "children": [
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "PbEnabledField"
                },
                "props": {
                  "direction": "column",
                  "style": {
                    "classes": "roast-gap-8"
                  }
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "PbEnabledFieldCap"
                    },
                    "props": {
                      "text": "Playback prompts on",
                      "style": {
                        "classes": "roast-form-caption"
                      }
                    }
                  },
                  {
                    "type": "ia.input.checkbox",
                    "meta": {
                      "name": "PbEnabledCheck"
                    },
                    "props": {
                      "selected": false,
                      "text": "",
                      "style": {
                        "classes": "roast-checkbox"
                      }
                    },
                    "propConfig": {
                      "props.selected": {
                        "binding": {
                          "type": "tag",
                          "config": {
                            "tagPath": "[default]Roastery/CurrentBatch/PlaybackEnabled",
                            "mode": "direct",
                            "bidirectional": true
                          },
                          "bidirectional": true
                        }
                      }
                    }
                  }
                ],
                "position": {
                  "grow": 1,
                  "shrink": 1,
                  "basis": "190px"
                }
